// Sums together all entries of sales in a network.
function combined_sales_of_network(nw) {
        // Base case:the tree is null / the tree has no children
        if (is_null(nw) || is_null(tail(nw))) {
            return tail(head(nw));
      } else {
            return tail(head(nw)) + accumulate((x, y) => (x + y), 0, map(combined_sales_of_network, tail(nw)));
        }
    }
    
