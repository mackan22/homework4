//Gets the desired root node for this task.
function modify_root_node(nw) {
    return pair(head(head(nw)), combined_sales_of_network(nw));
}

function modify_nodes_and_build_tree(nw) {
    if (is_null(nw)) {
        return null;
    } else if (is_null(tail(nw))) {
        return pair(modify_root_node(nw), null);
    } else {
        return pair(modify_root_node(nw), map(modify_nodes_and_build_tree, tail(nw)));
    }
}

