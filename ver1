//Converts a binary search tree to a list (with messy nestings).
function tree_to_list(given_tree) { //variant: height of tree
    return is_empty_tree(given_tree)
        ? null
        : list(tree_to_list(left_branch(given_tree)), 
               entry(given_tree), 
               tree_to_list(right_branch(given_tree)));
}

//Like append, but the arguments do not have to be lists.
function append_flexible(xs, ys) {
    if (! is_list(ys) && ! is_list(xs)) {
        return append(list(xs), list(ys));
    } else if (! is_list(ys)) {
        return append(xs, list(ys));
    } else if (! is_list(xs)) {
        return append(list(xs), ys);
    } else {
        return append(xs, ys);
    }
}

//Flatten a list one time.
function flatten_once(xs) {
    return accumulate(append_flexible, null, xs);
}

//Flatten a list multiple times.
function flatten_multiple_times(xs, cnt) { //variant: cnt
    return cnt === 0
        ? xs
        : flatten_multiple_times(flatten_once(xs), cnt - 1);
}

//Flatten a list completely, by flattening it 100 times.
function flatten_list(xs) {
    return flatten_multiple_times(xs, 100);
}

